# ---------------------------------------------------------------------
# Supabase (required)
# Both values are safe to expose to the browser; every write is protected
# by row level security. Never put a service_role key in a NEXT_PUBLIC_ var.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://kdpjflkzrstyefqktwta.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_e4-cy2RitzpHc9LPMNH56g_Ez4uZ6II

# ---------------------------------------------------------------------
# Optional: OAuth buttons are hidden unless the provider is enabled in the
# Supabase dashboard (Authentication -> Providers).
# ---------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_ENABLE_APPLE_AUTH=false

# ---------------------------------------------------------------------
# Optional: server-side LLM for the admin "AI生成" button. Without a key the
# admin screen falls back to a local rule-based draft generator.
# This is a SERVER-ONLY secret. Do not prefix it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------
# Used only by `npm run seed`. Must be an account with profiles.is_admin = true.
# ---------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
