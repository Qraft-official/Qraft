    "hint": "\u307e\u305a\u4e09\u89d2\u5f62ABC\u306e\u89d2C\u3092\u6c42\u3081\u3001\u305d\u306e\u3042\u3068\u4e09\u89d2\u5f62ADC\u306b\u6ce8\u76ee\u3057\u307e\u3057\u3087\u3046\u3002",
